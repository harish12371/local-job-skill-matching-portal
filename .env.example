# Flask Configuration
SECRET_KEY=your-super-secret-random-key-change-this-in-production
FLASK_ENV=development
FLASK_APP=app.py

# Database Configuration (External Managed Cloud MySQL Database)
# Format: mysql+pymysql://<username>:<password>@<host>:<port>/<database_name>?ssl_ca=/path/to/ca.pem
DATABASE_URL=mysql+pymysql://username:password@hostname:3306/local_job_portal

# Optional: Set to True for database debug logs
SQLALCHEMY_ECHO=False
